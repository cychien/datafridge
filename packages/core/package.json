{
  "name": "@datafridge/core",
  "version": "1.1.0",
  "description": "Proactively refreshed local reads for slow or unreliable APIs - core engine, zero runtime dependencies",
  "keywords": [
    "cache",
    "polling",
    "stale-if-error",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/datafridge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cychien/datafridge#readme",
  "bugs": "https://github.com/cychien/datafridge/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract-tests": {
      "types": "./dist/contract-tests.d.ts",
      "import": "./dist/contract-tests.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
