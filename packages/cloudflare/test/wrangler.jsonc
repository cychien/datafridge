{
  "name": "datafridge-cloudflare-tests",
  "main": "./worker.ts",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [{ "name": "POLLER", "class_name": "TestPoller" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestPoller"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datafridge-test",
      "database_id": "datafridge-test",
    },
  ],
}
