{
  "name": "@datafridge/cloudflare",
  "version": "0.0.0",
  "description": "Cloudflare adapters for datafridge - Durable Object alarms driver, D1 store, cron shell",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
