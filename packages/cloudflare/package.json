{
  "name": "@datafridge/cloudflare",
  "version": "0.0.0",
  "description": "Cloudflare adapters for datafridge - Durable Object alarms driver, D1 store, cron shell",
  "keywords": [
    "cloudflare-workers",
    "durable-objects",
    "d1",
    "scheduled"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/datafridge.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/cychien/datafridge#readme",
  "bugs": "https://github.com/cychien/datafridge/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "types": "./dist/index.d.ts",
  "bin": {
    "datafridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./do": {
      "types": "./dist/do.d.ts",
      "import": "./dist/do.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "import": "./dist/cron.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.cli.json"
  },
  "peerDependencies": {
    "@datafridge/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@datafridge/core": "workspace:*",
    "@types/node": "^24.0.0",
    "smol-toml": "^1.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
